{
  "manifest_version": 3,
  "name": "Craiova Parking Watch",
  "version": "1.0.3",
  "description": "Authenticated building and parking-space inventory, with clearly labeled auction demand and lifecycle states",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://parcari-ticketing.primariacraiova.ro/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Parking Watch"
  }
}
